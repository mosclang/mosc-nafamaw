##package=nafamaw
dunan kulu StringBuffer {

    dilan kura(capacity) => gansan
    dunan append_(data)
    dunan preppend_(data)
    dunan insert_(pos, data)
    dunan shrinkStart(count)
    dunan shrinkEnd(count)
    dunan size
    dunan data
    dunan isEmpty
    append(data) {
        ale.append_(data)
        segin niin ale
    }
    preppend(data) {
        ale.preppend_(data)
        segin niin ale
    }
    insert(pos, data) {
        ale.insert_(pos, data)
        segin niin ale
    }
    sebenma => ale.data
}